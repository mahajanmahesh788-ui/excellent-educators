APP_NAME=ExcellentEducators
# Local: APP_ENV=local, APP_DEBUG=true
# Production VPS: APP_ENV=production, APP_DEBUG=false (required)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8080
# Local can use *. Production MUST list exact origins (no *):
# CORS_ALLOWED_ORIGINS=https://excellenteducators.in,https://www.excellenteducators.in
CORS_ALLOWED_ORIGINS=*

APP_TIMEZONE=Asia/Kolkata
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=excellent_educators
DB_USERNAME=user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Local/tests: database is fine. Production VPS: prefer file (or redis) so
# every request does not hit the cache table for throttles/tokens.
# CACHE_STORE=file
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Forgot password needs a real mailer in production (log = write to laravel.log only).
# Hostinger / SMTP example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=noreply@yourdomain.com
#   MAIL_PASSWORD=********
#   MAIL_FROM_ADDRESS="noreply@yourdomain.com"
#   MAIL_FROM_NAME="${APP_NAME}"
# Also set FRONTEND_URL to the live web origin (reset links use /#/reset-password).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@excellenteducators.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=
# Token lifetime in minutes (shorter = less XSS window if a token is stolen)
SANCTUM_TOKEN_EXPIRATION=240

STUDENT_ID_CAMPAIGN_CODE=APS

SEED_ADMIN1_PASSWORD=ChangeMeAdmin1!
SEED_ADMIN2_PASSWORD=ChangeMeAdmin2!
SEED_ADMIN3_PASSWORD=ChangeMeAdmin3!

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MEET_DRIVER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_MEET_SCOPE=https://www.googleapis.com/auth/meetings.space.created
GOOGLE_SERVICE_ACCOUNT=
GOOGLE_SERVICE_ACCOUNT_PATH=
GOOGLE_WORKSPACE_USER=
GOOGLE_CALENDAR_ID=primary
